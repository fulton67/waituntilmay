research/ostad/3d/renders/*/frames/
research/ostad/3d/**/*.blend1
research/ostad/3d/renders/survey/*_[0-3].png

# housing bake intermediates (kit/bake writes them)
kit/work/

# brand kit: licensed font binaries read for metrics, never committed
brand/metrics/fontfiles/
brand/fonts/.chrome-profile/

research/design-systems/raw/
# BUILDER proofs: full-canvas renders and inpainted plates are reproducible intermediates (scripts/look_proof.py)
brand/look/proof/_r/
brand/look/proof/_plates/

# BUILDER B proof renders (thumbs + sheet are kept)
brand/kit/templates/_proof/

# Phase 4 motion frame grabs (regenerate with brand/scripts/motion.py; contact sheet in brand/fig/motion_contact.png)
brand/motion/frames/
# video kit frame sequences and ProRes masters (regenerate with brand/scripts/video_kit.cjs)
brand/kit/video/_frames/
brand/kit/video/_mov/
brand/kit/_page/
# edits made with scripts/video_edit.cjs: frame sequences and the mp4 stay local (regenerate from edit.json)
brand/edits/*/_frames/
brand/edits/*/*.mp4
# machine cutouts are the manufacturers' product photos: kept local, not republished in this public repo (rebuild: scripts/devices_fetch.py + kit/devices/sources.json)
brand/kit/devices/img/*.png
public/brand/ostad/kit/devices/img/
brand/kit/devices/ingest_report.json

# ── Intern CRM (/crm) ─────────────────────────────────────────────
# Supabase project (Auth magic links, Realtime, Storage bucket "resumes")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Seed script only — never exposed to the app
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase pooler, port 6543, is fine).
# Leave unset locally to use an embedded PGlite database in crm/.pglite
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Comma-separated emails allowed to sign in. The first one owns the seeded "Naim J." row.
CRM_ALLOWED_EMAILS=naimjohnson67@gmail.com
# Optional: timezone the schedule runs in (default America/New_York)
NEXT_PUBLIC_CRM_TZ=America/New_York
